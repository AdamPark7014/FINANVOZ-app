# Plantilla del .env de /opt/finanvoz-backend (chmod 600). Sin valores: los secretos viven en
# C:\dev\secrets\finanvoz-backend\ (un archivo por valor) y scripts/desplegar-backend.sh arma el .env del servidor.
# Nunca en git (regla 8).

# Dominio público (Traefik → finanvoz-kong:8000)
SUPABASE_PUBLIC_URL=https://finanvoz-api.zynoratek.com
SITE_URL=https://finanvoz.com
JWT_EXPIRY=3600

# Secretos generados (ver deploy/README.md: JWT HS256 con role anon / service_role firmados con JWT_SECRET)
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Funciones
NLU_PROVEEDORES=anthropic
NLU_TOPE_GLOBAL_DIARIO=2000
NLU_SAL_USUARIO=
LISTA_ESPERA_SAL=
CALCULADORA_ORIGEN=https://finanvoz.com
REVENUECAT_WEBHOOK_SECRET=
# Claude por la puerta única de IA de Adam (contenedor puerta-ia en la red proxy, o https://ia.zynoratek.com).
# La llave es el token de proyecto de C:\dev\secrets\puerta-ia\finanvoz.token.
ANTHROPIC_BASE_URL=http://puerta-ia:8080
ANTHROPIC_API_KEY=
# Opcionales: NLU_MODELO_ANTHROPIC, NLU_ANTHROPIC_MODO, LLM_MODELO_ANTHROPIC, OPENAI_API_KEY, GOOGLE_API_KEY

# Correo de la cuenta de respaldo (M9). Vacío = no sale ningún correo y la app no puede activar el respaldo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=FinanVoz
RATE_LIMIT_ANONYMOUS_USERS=60
