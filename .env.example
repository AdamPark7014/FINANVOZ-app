# Copia a .env (no se versiona). Ninguna llave de proveedor va en la app.

# --- App (apps/movil) — valores públicos ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
# M10: URL pública de plantillas.json y plantillas.json.sig. Las llaves PÚBLICAS de plantillas
# viven en el código (apps/movil/src/captura/llaves.ts), no aquí.
EXPO_PUBLIC_PLANTILLAS_URL=

# --- Proxy (services/proxy) — secretos: configúralos en el proyecto de Supabase, no aquí en producción ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
NLU_PROVEEDOR_PRINCIPAL=
NLU_PROVEEDOR_ALTERNO=
REVENUECAT_WEBHOOK_SECRET=

# --- Solo en la máquina de quien firma plantillas (M10). Nunca en CI, en la app ni en el repositorio ---
CARTERA_PLANTILLAS_LLAVE_PRIVADA_HEX=
