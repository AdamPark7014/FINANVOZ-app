# Copia a .env (no se versiona). Ninguna llave de proveedor va en la app.

# --- App (apps/movil) — valores públicos; en builds de EAS van como variables del perfil ---
# La URL y la llave anon de Supabase llegan a la app por `expo.extra` (app.config), no por estas variables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
# M10: llaves PÚBLICAS de plantillas remotas, `id:hex` separados por coma (p. ej. prod-2026:<hex>).
EXPO_PUBLIC_PLANTILLAS_LLAVES=

# --- Calculadora (apps/calculadora) — variables del entorno `produccion` de GitHub ---
VITE_LISTA_ESPERA_URL=
# Opcionales: si faltan se usan los datos de apps/calculadora/src/responsable.json.
VITE_RESPONSABLE_NOMBRE=
VITE_RESPONSABLE_DOMICILIO=
VITE_RESPONSABLE_CORREO=

# --- Proxy (services/proxy) — secretos: configúralos con `supabase secrets set`, no aquí en producción ---
# lista-espera (M0)
LISTA_ESPERA_SAL=
CALCULADORA_ORIGEN=
# nlu-interpretar (M3) y llm-turno (M10)
NLU_PROVEEDORES=anthropic,openai
NLU_TOPE_GLOBAL_DIARIO=
NLU_SAL_USUARIO=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
NLU_MODELO_ANTHROPIC=
NLU_MODELO_OPENAI=
NLU_MODELO_GOOGLE=
NLU_ANTHROPIC_MODO=
LLM_MODELO_ANTHROPIC=
LLM_MODELO_OPENAI=
LLM_MODELO_GOOGLE=
# webhooks-revenuecat (M7)
REVENUECAT_WEBHOOK_SECRET=

# --- Benchmark del intérprete contra el proxy desplegado (services/proxy/README.md) ---
NLU_PROXY_URL=
NLU_PROXY_JWT=

# La llave PRIVADA de plantillas (M10) nunca va en un archivo del repositorio: vive en el gestor de
# contraseñas y se pasa solo al firmar: `CARTERA_PLANTILLAS_LLAVE_PRIVADA_HEX=<hex> node scripts/firmar-plantillas.mjs`.
