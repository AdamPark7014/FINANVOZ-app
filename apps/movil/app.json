{
  "expo": {
    "name": "Finanvoz",
    "slug": "finanvoz",
    "scheme": "finanvoz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icono.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.finanvoz.app",
      "appleTeamId": "AHNW9K8745",
      "icon": "./assets/icono-ios.png",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSMicrophoneUsageDescription": "Finanvoz usa el micrófono para registrar lo que dictas.",
        "NSPhotoLibraryUsageDescription": "Finanvoz no lee tu galería de fotos. Si algún día eliges una imagen para importarla, se queda en tu teléfono."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["0A2A.1", "3B52.1", "C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.finanvoz.app",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-primer-plano.png",
        "monochromeImage": "./assets/android-monocromo.png",
        "backgroundColor": "#0A6B57"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Finanvoz usa la cámara solo para escanear el código QR de tu pareja en gastos compartidos.",
          "microphonePermission": "Finanvoz usa el micrófono para registrar lo que dictas.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/xml",
              "application/xml",
              "application/zip",
              "application/x-zip-compressed",
              "application/pdf"
            ],
            "multipleShareMimeTypes": [
              "text/xml",
              "application/xml",
              "application/zip",
              "application/x-zip-compressed"
            ]
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Finanvoz usa tu biometría para desbloquear la app."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Finanvoz usa el micrófono para registrar lo que dictas.",
          "speechRecognitionPermission": "Finanvoz convierte tu voz en texto para registrar movimientos.",
          "androidSpeechServicePackages": ["com.google.android.as", "com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A6B57"
        }
      ],
      "@sentry/react-native",
      "@cartera/captura-android",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "HoyPuedes",
              "label": "Hoy puedes",
              "description": "Cuánto puedes gastar hoy y cuántos días faltan para tu ingreso.",
              "previewImage": "./assets/widget-hoypuedes-preview.png",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      "./plugins/con-firma-android.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
