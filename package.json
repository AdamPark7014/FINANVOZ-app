{
  "name": "cartera",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "oraculo": "node scripts/oraculo.mjs --verificar",
    "eval:nlu": "pnpm --filter @cartera/nlu eval:nlu",
    "cobertura:core": "vitest run --project core --coverage --coverage.include='packages/core/src/**' --coverage.exclude='**/*.test.ts' --coverage.exclude='**/__pruebas__/**' --coverage.thresholds.lines=90 --coverage.reporter=text-summary"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "react-native-reanimated": "4.5.1"
    },
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
